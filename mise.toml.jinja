[tools]
python = "3.10"
uv = "0.11.17"

[env]
_.python.venv = { path = ".venv", create = true }
_.file = ".env"

[tasks.install]
description = "Install project dependencies"
run = """
uv sync
if git rev-parse --git-dir >/dev/null 2>&1; then
  if command -v pre-commit >/dev/null 2>&1; then
    pre-commit install
  else
    echo "WARNING: pre-commit not found, skipping hook installation"
  fi
else
  echo "Skipping pre-commit: not a Git repository"
fi
"""
{%- if "ruff" in dev_deps %}

[tasks.lint]
description = "Run linters"
run = "uv run ruff check --fix ."

[tasks.format]
description = "Format code"
depends = ["lint"]
run = "uv run ruff format ."
{%- endif %}
{%- if "pytest" in dev_deps %}

[tasks.unit]
description = "Run unit tests"
depends = ["clean"{% if "ruff" in dev_deps %}, "lint"{% endif %}]
run = "uv run pytest tests/unit/"

[tasks.test]
description = "Run all tests"
depends = ["clean"{% if "ruff" in dev_deps %}, "lint"{% endif %}]
run = "uv run pytest"

{%- if "ruff" in dev_deps %}
[tasks.ci]
description = "Run CI checks"
depends = ["lint", "unit", "format"]
{%- endif %}
{%- endif %}

[tasks.clean]
description = "Clean build and cache artifacts"
run = """
rm -rf build/ dist/ .pytest_cache .ruff_cache htmlcov .coverage
find . -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
find . -type d -name '*.egg-info' -exec rm -rf {} + 2>/dev/null || true
find . -type f -name '*.pyc' -delete 2>/dev/null || true
"""
